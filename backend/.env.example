# Copy to .env (never committed). Defaults work with `docker compose up -d`.
NODE_ENV=development
PORT=3000
# Frontend origin: CORS and links in e-mails.
WEB_URL=http://localhost:5173

# Same database as the frontend; the API owns the "app" schema, Payload the "payload" schema.
DATABASE_URL=postgresql://centre:centre@localhost:5432/centre_dev
REDIS_URL=redis://localhost:6379

# Long random strings, e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=604800

# smtp (Mailpit in development, UI on http://localhost:8025), brevo (production) or memory (tests).
MAIL_TRANSPORT=smtp
MAIL_FROM=Les Aînés <ne-pas-repondre@lesaines.test>
CENTER_EMAIL=info@lesaines.test
SMTP_HOST=localhost
SMTP_PORT=1025
BREVO_API_KEY=
BREVO_SANDBOX=true

# Cloudflare Turnstile. Empty in development skips the check; required in production.
TURNSTILE_SECRET_KEY=
# Online donations: "fake" serves a local payment page (no keys); "stripe" uses Stripe Checkout (test keys: sk_test_…).
PAYMENTS_DRIVER=fake
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (`stripe listen` prints one in development).
STRIPE_WEBHOOK_SECRET=whsec_local_development_only
API_PUBLIC_URL=http://localhost:3000/api/v1
# Assistant: "fake" embeddings work offline (development); "voyage" needs VOYAGE_API_KEY.
EMBEDDINGS_DRIVER=fake
VOYAGE_API_KEY=
# Shared with Payload (frontend CHATBOT_SYNC_SECRET): signs the page-change notifications.
CHATBOT_SYNC_SECRET=local-development-chatbot-sync-secret
# Receipts: "local" stores files in STORAGE_LOCAL_DIR (development); "r2" uses Cloudflare R2 (required in production).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_PUBLIC_URL=http://localhost:3000/api/v1
# Keeps local signed links valid across restarts (32+ characters).
STORAGE_SIGNING_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Requests per minute and per IP on every route (sign-in and public forms are stricter).
THROTTLE_LIMIT=300
THROTTLE_ENABLED=true
# Proxies allowed to give the visitor's address in X-Forwarded-For (the Next.js server, the load balancer).
TRUST_PROXY=loopback, linklocal, uniquelocal

LOG_LEVEL=info

# First administrator, created by `pnpm seed` when none exists (never committed).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
