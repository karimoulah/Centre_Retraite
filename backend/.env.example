# Copy to .env (never committed). Defaults work with `docker compose up -d`.
NODE_ENV=development
PORT=3000
# Frontend origin: CORS and links in e-mails.
WEB_URL=http://localhost:5173

# Same database as the frontend; the API owns the "app" schema, Payload the "payload" schema.
DATABASE_URL=postgresql://centre:centre@localhost:5432/centre_dev
REDIS_URL=redis://localhost:6379

# Long random strings, e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=604800

# smtp (Mailpit in development, UI on http://localhost:8025), brevo (production) or memory (tests).
MAIL_TRANSPORT=smtp
MAIL_FROM=Les Aînés <ne-pas-repondre@lesaines.test>
CENTER_EMAIL=info@lesaines.test
SMTP_HOST=localhost
SMTP_PORT=1025
BREVO_API_KEY=
BREVO_SANDBOX=true

# Cloudflare Turnstile. Empty in development skips the check; required in production.
TURNSTILE_SECRET_KEY=

LOG_LEVEL=info

# First administrator, created by `pnpm seed` when none exists (never committed).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
