# Copy to frontend/.env (never committed).

# Same PostgreSQL database as the API; Payload uses the "payload" schema.
DATABASE_URI=postgresql://centre:centre@localhost:5432/centre_dev

# Long random string, e.g. `openssl rand -hex 32`.
PAYLOAD_SECRET=change-me

# NestJS API, reached by the browser through the /backend/* rewrite.
API_URL=http://localhost:3000

# "mock" answers API calls from src/lib/api/mocks (F0-03), "live" calls NestJS.
API_MODE=mock

# Public URL of this site (SEO, absolute links, Payload preview).
NEXT_PUBLIC_SITE_URL=http://localhost:5173
